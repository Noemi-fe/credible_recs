# OS
.DS_Store

# The library of saved threads is Reddit content: it stays on this machine.
data/library/
# Products and quotes the AI extracted from gold-set threads: Reddit text, so it stays here too.
data/gold/extracted/
# Labelling pages embed comment text: they stay here too.
data/gold/labelling/

# Private planning notes. They stay on Noemi's machine only.
docs/

# Gold-set threads are Reddit content: they stay on Noemi's machine (her decision, 7 Oct 2026).
# data/gold/CANDIDATES.md lists their links, so the set can be fetched again.
data/gold/threads/*.json

# Candidate threads used to measure retrieval: Reddit titles, so they stay on this machine.
data/eval/

# Blind-test answers: ours quote Reddit, and the rivals' answers and the testers' names aren't ours to publish.
eval/blind_test/answers/
